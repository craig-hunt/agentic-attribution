{
    "name": "agentic-attribution/app",
    "description": "Publisher dashboard rendering the attribution chain from query to ledger",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Agentic\\Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agentic\\Dashboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 0.0.0.0:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
