{
    "name": "agentic-attribution/app",
    "description": "Publisher dashboard rendering the attribution chain from query to ledger",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Agentic\\Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agentic\\Dashboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 0.0.0.0:8000 -t public",
        "test:fast": "php tests/run.php",
        "mutate": "infection --threads=4 --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
